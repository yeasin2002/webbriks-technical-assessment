{
  "name": "webbriks-technical-assessment",
  "private": true,

  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @webbriks-technical-assessment/db db:push",
    "db:studio": "turbo -F @webbriks-technical-assessment/db db:studio",
    "db:generate": "turbo -F @webbriks-technical-assessment/db db:generate",
    "db:migrate": "turbo -F @webbriks-technical-assessment/db db:migrate",
    "db:start": "turbo -F @webbriks-technical-assessment/db db:start",
    "db:stop": "turbo -F @webbriks-technical-assessment/db db:stop",
    "db:status": "turbo -F @webbriks-technical-assessment/db db:status",
    "db:logs": "turbo -F @webbriks-technical-assessment/db db:logs",
    "db:down": "turbo -F @webbriks-technical-assessment/db db:down",
    "db:psql": "podman exec -it webbriks-postgres psql -U postgres -d webbriks-technical-assessment"
  },
  "dependencies": {
    "@webbriks-technical-assessment/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@webbriks-technical-assessment/config": "workspace:*",
    "lefthook": "^2.1.10",
    "turbo": "2.10.11",
    "typescript": "^6.0.3",
    "vercel": "^54.18.2"
  },
  "packageManager": "pnpm@11.5.1"
}
